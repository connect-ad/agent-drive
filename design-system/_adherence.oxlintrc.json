{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/ActivityRow/**",
              "components/AgentCard/**",
              "components/Alert/**",
              "components/ApiKeyDisplay/**",
              "components/AppShell/**",
              "components/Badge/**",
              "components/Button/**",
              "components/CodeBlock/**",
              "components/DataTable/**",
              "components/EmptyState/**",
              "components/FileCell/**",
              "components/Icon/**",
              "components/Input/**",
              "components/McpToolList/**",
              "components/Menu/**",
              "components/Modal/**",
              "components/Panel/**",
              "components/PermissionSelector/**",
              "components/Skeleton/**",
              "components/StatTile/**",
              "components/Tabs/**",
              "components/Toast/**",
              "components/UploadDropzone/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Public Sans|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Public Sans, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActivityRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:action|actor|actorType|resource|time|status|detail|className|key|ref|className|style|children)$/]",
        "message": "<ActivityRow> doesn't accept that prop. Declared props: action, actor, actorType, resource, time, status, detail, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActivityRow'] > JSXAttribute[name.name='actorType'] > Literal[value!=/^(?:user|agent)$/]",
        "message": "<ActivityRow> actorType must be one of 'user' | 'agent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActivityRow'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:ok|denied|error)$/]",
        "message": "<ActivityRow> status must be one of 'ok' | 'denied' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgentCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|slug|status|permission|workspace|lastActive|requests|transport|onOpen|className|key|ref|className|style|children)$/]",
        "message": "<AgentCard> doesn't accept that prop. Declared props: name, slug, status, permission, workspace, lastActive, requests, transport, onOpen, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgentCard'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:active|idle|no_key|key_expired|revoked)$/]",
        "message": "<AgentCard> status must be one of 'active' | 'idle' | 'no_key' | 'key_expired' | 'revoked'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|children|actions|icon|className|key|ref|className|style|children)$/]",
        "message": "<Alert> doesn't accept that prop. Declared props: tone, title, children, actions, icon, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent|ok|warn|danger)$/]",
        "message": "<Alert> tone must be one of 'neutral' | 'accent' | 'ok' | 'warn' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ApiKeyDisplay'] > JSXAttribute > JSXIdentifier[name!=/^(?:secret|lastFour|prefix|revealed|onAcknowledge|className|key|ref|className|style|children)$/]",
