        "message": "<Checkbox> doesn't accept that prop. Declared props: label, description, radio, checked, defaultChecked, disabled, name, value, className, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='CodeBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:code|filename|theme|copyable|actions|className|key|ref|className|style|children)$/]",
